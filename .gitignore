/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Local screenshot/reference folders (not for version control)
node_modules_error/
UI_MISMATCH_IN_NATIVE/
addviewat-crash-reference.png
create-screen-reference.png

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env
.env.production
.env.backend

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# vite
/dist

# Expo / React Native — mobile/
mobile/node_modules/
mobile/.expo/
mobile/dist/
mobile/.metro-health-check*

# Firebase config — contains API keys, never commit
firebase/
mobile/android/app/google-services.json
mobile/ios/**/GoogleService-Info.plist

# Android build artifacts
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/app/build/
mobile/android/build/
mobile/android/.idea/
mobile/android/captures/
*.jks
*.keystore
*.aab
*.apk

# iOS build artifacts
mobile/ios/build/
mobile/ios/Pods/
mobile/ios/*.xcworkspace/xcuserdata/
mobile/ios/*.xcodeproj/xcuserdata/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata

# Metro bundler cache
/tmp/metro-cache/
mobile/.metro-cache/

# Shared package build output
packages/shared/dist/
packages/shared/*.tsbuildinfo
