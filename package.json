{
  "name": "ctrend-root",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node mobile/scripts/setup-secrets.js",
    "dev": "vite",
    "local": "VITE_GRAPHQL_HTTP=http://localhost:4000/graphql VITE_GRAPHQL_WS=ws://localhost:4000/graphql VITE_ENABLE_ENGAGEMENT_GQL=true vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "mobile:start": "npm run start -w mobile",
    "mobile:android": "npm run android -w mobile",
    "mobile:prebuild": "npm run prebuild -w mobile -- --platform android",
    "mobile:apk": "npm run apk -w mobile"
  },
  "dependencies": {
    "@apollo/client": "^3.13.8",
    "@ctrend/shared": "workspace:*",
    "@react-oauth/google": "^0.13.5",
    "apollo3-cache-persist": "^0.15.0",
    "expo": "~56.0.6",
    "graphql": "^16.11.0",
    "graphql-ws": "^6.0.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.85.3",
    "react-router-dom": "^7.14.0",
    "sharp": "^0.35.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.4"
  }
}
