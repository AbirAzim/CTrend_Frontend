# GraphQL HTTP endpoint (required)
# Local: http://localhost:4000/graphql
# Production example: https://ctrend.onrender.com/graphql
VITE_GRAPHQL_HTTP=http://localhost:4000/graphql
# GraphQL WS endpoint (optional but required for realtime subscriptions)
# Local: ws://localhost:4000/graphql
# Production example: wss://ctrend.onrender.com/graphql
# VITE_GRAPHQL_WS=ws://localhost:4000/graphql

# Google Sign-In — Web client ID only (safe in frontend). Never put Client Secret here.
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Public contact email on /privacy and /terms (Play Store, data requests)
# VITE_PRIVACY_CONTACT_EMAIL=badhonkhanbk007@gmail.com

# true = demo feed + votes stay in browser only. false/unset = use GraphQL feedPosts + votePost
# VITE_USE_MOCK_FEED=true

