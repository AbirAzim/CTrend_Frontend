# GraphQL HTTP endpoint (required)
VITE_GRAPHQL_HTTP=http://localhost:4000/graphql

# Google Sign-In — Web client ID only (safe in frontend). Never put Client Secret here.
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# true = demo feed + votes stay in browser only. false/unset = use GraphQL feedPosts + votePost
# VITE_USE_MOCK_FEED=true
