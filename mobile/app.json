{
  "expo": {
    "name": "Ke Jitbe",
    "slug": "ke-jitbe",
    "version": "1.1.0",
    "scheme": "ctrend",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.ctrend.app",
      "versionCode": 16,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#312e81",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "kejitbe.app", "pathPrefix": "/post" },
            { "scheme": "https", "host": "www.kejitbe.app", "pathPrefix": "/post" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-image",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.41983174733-rpq1s0k95fhnme4jfrb2uv2usfq4p1ce"
        }
      ],
      "expo-audio",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#312e81"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
